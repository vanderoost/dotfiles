# Reload with [ctrl][shift][,] (Linux) or [cmd][shift][,] (MacOS)

# Original TokyoNight background: https://oklch.com/#0.2261,0.0211,279.34,100
# background = 1A1B26

# Slightly darker background: https://oklch.com/#0.19,0.0211,279.34,100
background = 12131d
background-blur = 32
background-opacity = 0.8
background-opacity-cells = true
theme = light:TokyoNight Day,dark:TokyoNight Night

font-thicken = true
macos-titlebar-style = hidden
mouse-hide-while-typing = true
window-padding-balance = true
window-step-resize = false

# Fancy cursor warp stuff deluxe
custom-shader = shaders/cursor_warp.glsl

# For Claude code or whatever LLM wrapper du jour
keybind = shift+enter=text:\x1b\r
